{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python scripts/hooks/session_start.py" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "python scripts/hooks/guard_write.py" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python scripts/hooks/guard_bash.py" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "python scripts/hooks/post_write.py" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python scripts/hooks/scan_output.py" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python scripts/hooks/stop_check.py" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python scripts/hooks/subagent_stop.py" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "python scripts/hooks/pre_compact.py" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo *)", "Bash(rustfmt *)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git worktree *)", "Bash(git checkout *)", "Bash(git switch *)",
      "Bash(git pull*)", "Bash(git fetch*)", "Bash(git push origin swarm/*)", "Bash(node *)", "Bash(npm *)",
      "Bash(python *)", "Bash(docker compose *)", "Bash(psql *)", "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push origin main*)", "Bash(cargo publish*)", "Read(./**/*.age)", "Read(./.env)"
    ]
  }
}
